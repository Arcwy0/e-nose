# syntax=docker/dockerfile:1.6
#
# enose-server — purpose-built image for the FastAPI server
#   • Florence-2 VLM (inference only)
#   • BalancedRF / XGBoost smell classifier
#
# Design notes:
#   - Everything Florence-2-Large does NOT need has been removed: no vLLM,
#     no flash-attn, no gradio, no deepspeed, no mistral-common, no dashscope.
#     Those dragged in transformers>=4.56 / torch==X.Y constraints that
#     conflict with Florence-2's custom configuration_florence2.py.
#   - requirements-server.txt is the full version lock also used by pip/uv.
#     It retains the working Torch 2.4.1/cu124 and Transformers 4.44.2 stack.
#   - FlashAttention 2.7.3 remains installed after Torch (no build isolation).
#   - Project source is NOT copied in; it is bind-mounted at runtime via
#     `-v "$(pwd)":/app`. `PYTHONPATH=/app` makes `import enose` work.
#     This keeps rebuilds snappy — edits to Python files do not invalidate
#     any Docker layer.
#
# Build:
#   docker build -t enose-server -f docker/Dockerfile-cu124 .
#
# Run (full mode, VLM + classifier):
#   docker run -it --name florence2 --gpus '"device=0"' \
#       --network enose-net -p 8016:8080 \
#       -v "$(pwd)":/app -e PYTHONPATH=/app \
#       --env-file .env enose-server \
#       python scripts/run_server.py
#
# Run (smell-only, skip VLM load — same image, no GPU needed):
#   docker run -it --name enose-smell --network enose-net \
#       -p 8016:8080 -v "$(pwd)":/app \
#       -e PYTHONPATH=/app -e ENOSE_NO_VLM=1 -e ENOSE_CLASSIFIER=xgb \
#       enose-server python scripts/run_server.py

ARG CUDA_VERSION=12.4.1
# The reference Linux CUDA install retains FlashAttention, which can compile
# CUDA kernels during install and therefore needs nvcc and the -devel base.
FROM nvidia/cuda:${CUDA_VERSION}-cudnn-devel-ubuntu22.04 AS base

ARG DEBIAN_FRONTEND=noninteractive

# ── System packages ──────────────────────────────────────────────────────────
RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        git \
        git-lfs \
        python3 \
        python3-pip \
        python3-dev \
        wget \
        ca-certificates \
        libgl1 \
        libglib2.0-0 \
        libsm6 \
        libxext6 \
        libxrender1 \
    && rm -rf /var/lib/apt/lists/* \
    && ln -sf /usr/bin/python3 /usr/bin/python \
    && git lfs install

ENV CUDA_HOME=/usr/local/cuda
ENV PYTHONDONTWRITEBYTECODE=1
ENV PYTHONUNBUFFERED=1
ENV PIP_NO_CACHE_DIR=1
ENV PIP_DISABLE_PIP_VERSION_CHECK=1
ENV MPLBACKEND=Agg
ENV PYTHONPATH=/app

WORKDIR /app

# ── Shared, complete Python runtime lock ───────────────────────────────────
COPY requirements-server.txt requirements-flash-build.txt requirements-flash-attn.txt ./
COPY requirements/server-lock.txt ./requirements/server-lock.txt

RUN python -m pip install --upgrade "pip==24.3.1" \
    && python -m pip install -r requirements-server.txt \
    && python -m pip check

# Install the extension only AFTER the locked Torch runtime and build tools.
# The same sequence is documented for native Linux pip and uv environments.
ENV MAX_JOBS=4
RUN python -m pip install -r requirements-flash-build.txt \
    && python -m pip install --no-build-isolation -r requirements-flash-attn.txt \
    && python -m pip check

EXPOSE 8080

CMD ["/bin/bash"]
